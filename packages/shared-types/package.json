{
   "name": "@sonory/shared-types",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "main": "dist/index.js",
   "types": "dist/index.d.ts",
   "scripts": {
      "build": "tsc",
      "dev": "tsc --watch",
      "fetch:openapi": "tsx scripts/fetch-openapi.ts",
      "generate:types": "tsx scripts/generate-types.ts",
      "check:generated": "tsx scripts/check-generated.ts",
      "lint": "oxlint .",
      "lint:fix": "oxlint . --fix",
