{
   "name": "@sonory/shared-types",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "main": "dist/index.js",
   "types": "dist/index.d.ts",
   "scripts": {
      "build": "tsc",
      "dev": "tsc --watch",
      "lint": "biome check --write .",
      "lint:check": "biome check .",
      "format": "biome format . --write",
      "type-check": "tsc --noEmit",
      "clean": "rm -rf dist",
      "generate:openapi": "openapi-typescript openapi.json -o src/generated/api.d.ts"
   },
   "devDependencies": {
      "@biomejs/biome": "2.3.8",
      "openapi-typescript": "^7.13.0",
      "typescript": "^5.9.3"
   },
   "dependencies": {
      "zod": "^4.4.3"
   }
}
