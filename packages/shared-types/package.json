{
   "name": "@sonory/shared-types",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "main": "dist/index.js",
   "types": "dist/index.d.ts",
   "scripts": {
      "build": "tsc",
      "dev": "tsc --watch",
      "fetch:openapi": "tsx scripts/fetch-openapi.ts",
      "generate:types": "tsx scripts/generate-types.ts",
      "check:generated": "tsx scripts/check-generated.ts",
      "lint": "biome check --write .",
      "lint:check": "biome check .",
      "format": "biome format . --write",
      "type-check": "tsc --noEmit",
      "clean": "rm -rf dist"
   },
   "devDependencies": {
      "@biomejs/biome": "2.3.8",
      "@types/node": "^24.12.4",
      "openapi-typescript": "^7.13.0",
      "tsx": "^4.22.4",
      "typescript": "^5.9.3"
   },
   "dependencies": {
      "zod": "^4.4.3"
   }
}
