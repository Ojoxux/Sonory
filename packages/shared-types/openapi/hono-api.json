    "/api/pins": {
      "post": {
        "tags": [
          "Pins"
        ],
        "summary": "ピン作成",
        "description": "新しい音声ピンを作成",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "location": {
                    "type": "object",
                    "properties": {
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lng": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "accuracy": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMinimum": true
                      }
                    },
                    "required": [
                      "lat",
                      "lng"
                    ]
                  },
                  "audio": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "duration": {
                        "type": "number",
                        "minimum": 9.9,
                        "maximum": 600
                      },
                      "format": {
                        "type": "string",
                        "enum": [
                          "webm",
                          "mp3",
                          "wav"
                        ]
                      }
                    },
                    "required": [
                      "url",
                      "duration",
                      "format"
                    ]
                  },
                  "audio_file_path": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "object",
                    "properties": {
                      "duration": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMinimum": true
                      },
                      "timeTag": {
                        "type": "string",
                        "enum": [
                          "朝",
                          "昼",
                          "夕",
                          "夜"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "deviceInfo": {
                        "type": "string"
                      },
                      "weather": {
                        "type": "object",
                        "properties": {
                          "temperature": {
                            "type": "number"
                          },
                          "condition": {
                            "type": "string",
                            "nullable": true
                          },
                          "windSpeed": {
                            "type": "number",
                            "nullable": true
                          },
                          "humidity": {
                            "type": "number",
                            "nullable": true,
                            "minimum": 0,
                            "maximum": 100
                          }
                        },
                        "required": [
                          "temperature"
                        ]
                      }
                    }
                  },
                  "weather": {
                    "type": "object",
                    "properties": {
                      "temperature": {
                        "type": "number"
                      },
                      "condition": {
                        "type": "string",
                        "nullable": true
                      },
                      "windSpeed": {
                        "type": "number",
                        "nullable": true
                      },
                      "humidity": {
                        "type": "number",
                        "nullable": true,
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "temperature"
                    ]
                  },
                  "timeTag": {
                    "type": "string",
                    "enum": [
                      "朝",
                      "昼",
                      "夕",
                      "夜"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "deviceInfo": {
                    "type": "string"
                  }
                },
                "required": [
                  "location"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "作成されたピン",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "nullable": true
                    }
                  },
                  "required": [
                    "success"
                  ]
                }
              }
            }
          }
        }
      }
    },
