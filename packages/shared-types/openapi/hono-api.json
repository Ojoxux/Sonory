    "description": "音声ピン管理・AI分析のためのAPI。Hono + Cloudflare Workers上で動作。"
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "ローカル開発環境"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "基本ヘルスチェック",
        "description": "Supabase接続確認付きの基本的なヘルスチェック",
        "responses": {
          "200": {
            "description": "サービス状態",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "healthy",
                            "degraded",
                            "unhealthy"
                          ]
                        },
                        "timestamp": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "services": {
                          "type": "object",
                          "properties": {
                            "database": {
                              "type": "string",
                              "enum": [
                                "connected",
                                "disconnected"
                              ]
                            },
                            "storage": {
                              "type": "string",
                              "enum": [
                                "connected",
                                "disconnected"
                              ]
                            },
                            "ai": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable"
                              ]
                            }
                          },
                          "required": [
                            "database",
                            "storage",
                            "ai"
                          ]
                        },
                        "uptime": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "status",
                        "timestamp",
                        "version",
                        "services",
                        "uptime"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
