              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "healthy",
                            "degraded",
                            "unhealthy"
                          ]
                        },
                        "timestamp": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "services": {
                          "type": "object",
                          "properties": {
                            "database": {
                              "type": "string",
                              "enum": [
                                "connected",
                                "disconnected"
                              ]
                            },
                            "storage": {
                              "type": "string",
                              "enum": [
                                "connected",
                                "disconnected"
                              ]
                            },
                            "ai": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable"
                              ]
                            }
                          },
                          "required": [
                            "database",
                            "storage",
                            "ai"
                          ]
                        },
                        "uptime": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "status",
                        "timestamp",
                        "version",
