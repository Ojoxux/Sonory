{
   "name": "@sonory/python-types",
   "version": "0.1.0",
   "description": "Generate Python type definitions from TypeScript shared types",
   "main": "dist/index.js",
   "types": "dist/index.d.ts",
   "scripts": {
      "build": "tsc",
      "dev": "tsc --watch",
      "generate": "node dist/generate-python-types.js",
      "clean": "rm -rf dist/ && rm -rf ../python-audio-analyzer/src/types/generated/",
      "lint": "biome check --write .",
      "lint:check": "biome check .",
      "format": "biome format . --write",
      "type-check": "tsc --noEmit"
   },
   "dependencies": {
      "@sonory/shared-types": "file:../shared-types",
      "typescript": "^5.9.3"
   },
   "devDependencies": {
      "@biomejs/biome": "2.2.6",
      "@types/node": "^22.18.12"
   }
}
