{
	"name": "sonory-monorepo",
	"version": "0.1.0",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"fix": "turbo fix",
		"fix:check": "turbo fix:check",
		"fix:style": "turbo fix:style",
		"fix:all": "turbo fix:all",
		"test": "turbo test",
		"clean": "turbo clean",
		"type-check": "turbo type-check",
		"lint-staged": "lint-staged",
		"dev:web": "turbo dev --filter=@sonory/web",
		"dev:api": "turbo dev --filter=@sonory/api",
		"build:web": "turbo build --filter=@sonory/web",
		"build:api": "turbo build --filter=@sonory/api",
		"deploy:api": "turbo deploy --filter=@sonory/api",
		"deploy:web": "turbo deploy --filter=@sonory/web",
		"prepare": "husky",
		"postinstall": "turbo build --filter=@sonory/shared-types --filter=@sonory/utils",
		"setup": "npm install && npm run build",
		"setup:env": "bash scripts/setup-env.sh",
		"start:all": "concurrently \"npm run start:python\" \"npm run start:api\" \"npm run start:frontend\" --names \"🐍Python,🔗API,📱Frontend\" --prefix-colors \"yellow,blue,green\"",
		"start:backend": "concurrently \"npm run start:python\" \"npm run start:api\" --names \"🐍Python,🔗API\" --prefix-colors \"yellow,blue\"",
		"start:frontend": "cd apps/web && npm run dev",
		"start:api": "cd apps/api && npm run dev",
		"start:python": "cd apps/python-audio-analyzer && python3 -m uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
		"stop:all": "pkill -f 'next|wrangler|uvicorn' || echo 'All services stopped'",
		"win:setup": "cd apps/python-audio-analyzer && setup-windows.bat",
		"win:debug": "cd apps/python-audio-analyzer && powershell -ExecutionPolicy Bypass -File debug-windows.ps1",
		"win:start:python": "cd apps/python-audio-analyzer && python -m uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
		"win:start:all": "concurrently \"npm run win:start:python\" \"npm run start:api\" \"npm run start:frontend\" --names \"🐍Python,🔗API,📱Frontend\" --prefix-colors \"yellow,blue,green\""
	},
	"dependencies": {
		"@ducanh2912/next-pwa": "^10.2.9",
		"@mapbox/mapbox-gl-geocoder": "^5.0.3",
		"@supabase/supabase-js": "^2.49.8",
		"fp-ts": "^2.16.10",
		"framer-motion": "^12.15.0",
		"idb": "^8.0.3",
		"lucide-react": "^0.514.0",
		"mapbox-gl": "^3.12.0",
		"next": "15.3.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-icons": "^5.5.0",
		"recordrtc": "^5.6.2",
		"uuid": "^11.1.0",
		"wavesurfer.js": "^7.9.5",
		"zod": "^3.25.28",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^20",
		"concurrently": "^9.2.0",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.2",
		"turbo": "^2.0.0",
		"typescript": "^5"
	},
	"lint-staged": {
		"apps/web/**/*.{js,jsx,ts,tsx}": [
			"cd apps/web && npx biome check --fix --unsafe . && npx biome format . --write --unsafe",
			"cd apps/web && npx tsc --noEmit"
		],
		"apps/api/**/*.{js,jsx,ts,tsx}": [
			"cd apps/api && npx biome check --fix --unsafe . && npx biome format . --write --unsafe",
			"cd apps/api && npx tsc --noEmit"
		],
		"packages/shared-types/**/*.{js,jsx,ts,tsx}": [
			"cd packages/shared-types && npx biome check --fix --unsafe . && npx biome format . --write --unsafe",
			"cd packages/shared-types && npx tsc --noEmit"
		],
		"packages/utils/**/*.{js,jsx,ts,tsx}": [
			"cd packages/utils && npx biome check --fix --unsafe . && npx biome format . --write --unsafe",
			"cd packages/utils && npx tsc --noEmit"
		],
		"packages/python-types/**/*.{js,jsx,ts,tsx}": [
			"cd packages/python-types && npx biome check --fix --unsafe . && npx biome format . --write --unsafe",
			"cd packages/python-types && npx tsc --noEmit"
		],
		"packages/config/**/*.{js,jsx,ts,tsx}": [
			"npx biome check --fix --unsafe packages/config && npx biome format packages/config --write --unsafe"
		]
	},
	"packageManager": "npm@10.0.0"
}
