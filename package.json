{
   "name": "sonory-monorepo",
   "version": "0.1.0",
   "private": true,
   "workspaces": [
      "apps/web",
      "apps/api",
      "packages/*"
   ],
   "scripts": {
      "prepare": "lefthook install --reset-hooks-path",
      "postinstall": "turbo build --filter=@sonory/shared-types --filter=@sonory/utils"
   },
   "dependencies": {
      "@sonory/config": "*",
      "@sonory/shared-types": "*",
      "@sonory/utils": "*"
   },
   "devDependencies": {
      "@types/node": "^24.13.4",
      "concurrently": "^10.0.5",
      "lefthook": "^2.1.12",
      "oxfmt": "^0.67.0",
      "oxlint": "^1.82.0",
      "turbo": "^2.10.12",
      "typescript": "^7.0.2"
   },
   "packageManager": "npm@10.9.4"
}
