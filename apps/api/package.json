{
   "name": "@sonory/api",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "wrangler dev --port 8787",
      "prebuild": "npm run generate-types",
      "build": "tsc && tsc-alias -p tsconfig-paths.json --resolve-full-paths",
      "deploy": "wrangler deploy",
      "deploy:staging": "wrangler deploy --env staging",
      "deploy:production": "wrangler deploy --env production",
      "generate-types": "wrangler types",
      "pretype-check": "npm run generate-types",
      "lint": "biome check src",
      "lint:fix": "biome check --fix --unsafe src",
      "format": "biome format .",
      "format:fix": "biome format . --write",
      "type-check": "tsc --noEmit",
      "validate": "npm run lint && npm run type-check",
      "test": "vitest",
      "test:watch": "vitest --watch",
      "precommit": "npm run lint:fix && npm run format:fix",
      "clean": "rm -rf dist .wrangler"
   },
   "dependencies": {
      "@hono/zod-validator": "^0.7.4",
      "@sonory/shared-types": "file:../../packages/shared-types",
      "@sonory/utils": "file:../../packages/utils",
      "@supabase/supabase-js": "^2.81.1",
      "hono": "^4.10.6",
      "vite": "^7.2.2",
      "zod": "^4.1.12"
   },
   "devDependencies": {
      "@biomejs/biome": "2.3.5",
      "@types/node": "^24.10.1",
      "tsc-alias": "^1.8.16",
      "typescript": "^5.9.3",
      "vitest": "^4.0.9",
      "wrangler": "^4.48.0"
   }
}
