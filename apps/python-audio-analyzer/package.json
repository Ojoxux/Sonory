{
	"name": "@sonory/python-audio-analyzer",
	"version": "0.1.0",
	"description": "YAMNet-based audio analysis service for Sonory",
	"private": true,
	"scripts": {
		"dev": "python3 -m uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
		"build": "docker build -t sonory-audio-analyzer .",
		"start": "python3 -m uvicorn src.main:app --host 0.0.0.0 --port 8000",
		"install": "python3 -m pip install -e .[dev]",
		"lint": "python3 -m ruff check .",
		"lint:fix": "python3 -m ruff check . --fix",
		"lint:typecheck": "python3 -m mypy .",
		"format": "python3 -m ruff format .",
		"format:check": "python3 -m ruff format . --check",
		"test": "pytest",
		"test:watch": "pytest --watch",
		"clean": "rm -rf .pytest_cache __pycache__ .mypy_cache dist build *.egg-info",
		"ci": "npm run lint && npm run format:check && npm run build",
		"precommit": "npm run lint:fix && npm run format",
		"generate-types": "echo 'Types will be generated by python-types package'",
		"win:setup": "powershell -ExecutionPolicy Bypass -File setup-windows.ps1",
		"win:debug": "powershell -ExecutionPolicy Bypass -File setup-windows.ps1 -CheckHealth"
	}
}
