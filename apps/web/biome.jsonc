{
   "$schema": "https://biomejs.dev/schemas/2.3.4/schema.json",
   "extends": ["../../packages/config/biome.json"],
   "files": {
      "experimentalScannerIgnores": [".next/**", "public/**"]
   },
   "linter": {
      "rules": {
         "suspicious": {
            "noReactSpecificProps": "off",
            "noConsole": {
               "level": "off",
               "options": {
                  "allow": ["log", "warn", "error", "info"]
               }
            }
         },
         "style": {
            "useNamingConvention": "off"
         },
         "complexity": {
            "noExcessiveCognitiveComplexity": {
               "level": "warn",
               "options": {
                  "maxAllowedComplexity": 15
               }
            }
         },
         "a11y": {
            "useKeyWithClickEvents": "warn",
            "useButtonType": "warn"
         },
         "correctness": {
            "noUnusedVariables": {
               "level": "warn"
            },
            "useExhaustiveDependencies": "error"
         }
      }
   },
   "overrides": [
      {
         "includes": ["src/app/api/**/*.ts"],
         "linter": {
            "rules": {
               "style": {
                  "useNamingConvention": "off"
               }
            }
         }
      }
   ]
}
