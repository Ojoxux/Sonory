{
   "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
   "extends": ["../../packages/config/biome.json"],
   "files": {
      "experimentalScannerIgnores": [
         ".next/**",
         "public/sw.js",
         "public/workbox-*.js",
         "public/worker-*.js",
         "public/fallback-*.js",
         "public/*.map"
      ]
   },
   "linter": {
      "rules": {
         "suspicious": {
            "noReactSpecificProps": "off",
            "noConsole": {
               "level": "off",
               "options": {
                  "allow": ["log", "warn", "error", "info"]
               }
            }
         },
         "style": {
            "useNamingConvention": "off"
         },
         "complexity": {
            "noExcessiveCognitiveComplexity": {
               "level": "warn",
               "options": {
                  "maxAllowedComplexity": 50
               }
            }
         },
         "a11y": {
            "useKeyWithClickEvents": "warn",
            "useButtonType": "warn"
         },
         "correctness": {
            "noUnusedVariables": {
               "level": "warn"
            },
            "useExhaustiveDependencies": "off"
         }
      }
   },
   "overrides": [
      {
         "includes": ["src/app/api/**/*.ts"],
         "linter": {
            "rules": {
               "style": {
                  "useNamingConvention": "off"
               }
            }
         }
      },
      {
         "includes": ["*.tsx", "*.ts"],
         "linter": {
            "rules": {
               "correctness": {
                  "useExhaustiveDependencies": "off"
               }
            }
         }
      }
   ]
}
