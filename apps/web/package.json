{
   "name": "@sonory/web",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "next dev --turbopack --port 3000",
      "build": "next build",
      "start": "next start",
      "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
      "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
      "deploy:staging": "NEXT_PUBLIC_API_URL=https://sonory-api-staging.workers.dev NEXT_PUBLIC_SITE_URL=https://sonory-web-staging.workers.dev opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
      "deploy:production": "NEXT_PUBLIC_API_URL=https://sonory-api-production.workers.dev NEXT_PUBLIC_SITE_URL=https://sonory-web-production.workers.dev opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
      "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
      "lint": "oxlint .",
      "lint:fix": "oxlint . --fix",
      "format": "oxfmt --check .",
      "format:fix": "oxfmt .",
      "type-check": "tsc --noEmit",
      "validate": "npm run lint && npm run type-check && npm run test",
      "clean": "rm -rf .next .open-next out node_modules/.cache",
      "ci": "npm run validate && npm run build",
      "test": "vitest run",
      "test:watch": "vitest --watch",
      "precommit": "npm run lint:fix && npm run format:fix"
   },
   "dependencies": {
      "@ducanh2912/next-pwa": "^10.2.9",
      "@mapbox/mapbox-gl-geocoder": "^5.1.2",
      "@opennextjs/cloudflare": "^1.20.4",
      "@sonory/shared-types": "*",
      "@supabase/supabase-js": "^2.112.4",
      "@tanstack/react-query": "^5.102.7",
      "framer-motion": "^12.43.0",
      "idb": "^8.0.3",
      "lucide-react": "^1.34.0",
      "mapbox-gl": "^3.29.0",
      "motion": "^12.43.0",
      "next": "^16.2.11",
      "ogl": "^1.0.11",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "react-icons": "^5.7.0",
      "react-modal-sheet": "^5.6.0",
      "recordrtc": "^5.6.2",
      "uuid": "^14.0.2",
      "wavesurfer.js": "^7.12.11",
      "wrangler": "^4.127.0",
      "zod": "^4.4.3",
      "zustand": "^5.0.15"
   },
   "devDependencies": {
      "@tailwindcss/postcss": "^4.3.3",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.2",
      "@types/mapbox__mapbox-gl-geocoder": "^5.1.2",
      "@types/node": "^24.13.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "@types/uuid": "^11.0.0",
      "jsdom": "^29.1.1",
      "tailwindcss": "^4.3.3",
      "typescript": "^5.9.3",
      "vitest": "^4.1.11"
   }
}
