{
   "name": "@sonory/web",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "next dev --turbopack --port 3000",
      "build": "next build",
      "start": "next start",
      "lint": "npm run lint:biome && npm run lint:eslint",
      "lint:biome": "biome check src",
      "lint:eslint": "eslint .",
      "lint:fix": "npm run lint:biome:fix && npm run lint:eslint:fix",
      "lint:biome:fix": "biome check --fix --unsafe src",
      "lint:eslint:fix": "eslint . --fix",
      "format": "biome format .",
      "format:fix": "biome format . --write",
      "type-check": "tsc --noEmit",
      "validate": "npm run lint && npm run type-check",
      "clean": "rm -rf .next out node_modules/.cache",
      "ci": "npm run validate && npm run build",
      "precommit": "npm run lint:fix && npm run format:fix"
   },
   "dependencies": {
      "@ducanh2912/next-pwa": "^10.2.9",
      "@mapbox/mapbox-gl-geocoder": "^5.1.2",
      "@supabase/supabase-js": "^2.76.1",
      "@tanstack/react-query": "^5.90.5",
      "fp-ts": "^2.16.11",
      "framer-motion": "^12.23.24",
      "idb": "^8.0.3",
      "lucide-react": "^0.546.0",
      "mapbox-gl": "^3.16.0",
      "motion": "^12.23.24",
      "next": "^15.5.6",
      "ogl": "^1.0.11",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "react-icons": "^5.5.0",
      "react-modal-sheet": "^5.2.1",
      "recordrtc": "^5.6.2",
      "use-effect-event": "^2.0.3",
      "uuid": "^13.0.0",
      "wavesurfer.js": "^7.11.0",
      "zod": "^4.1.12",
      "zustand": "^5.0.8"
   },
   "devDependencies": {
      "@biomejs/biome": "2.2.6",
      "@eslint/js": "^9.38.0",
      "@tailwindcss/postcss": "^4.1.16",
      "@types/mapbox__mapbox-gl-geocoder": "^5.1.0",
      "@types/mapbox-gl": "^3.4.1",
      "@types/node": "^22.18.12",
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.2.2",
      "@types/uuid": "^11.0.0",
      "eslint": "^9.38.0",
      "eslint-plugin-react-you-might-not-need-an-effect": "^0.6.1",
      "globals": "^16.4.0",
      "tailwindcss": "^4.1.16",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.46.2"
   }
}
