{
   "name": "@sonory/web",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "next dev --turbopack --port 3000",
      "build": "next build",
      "start": "next start",
      "lint": "npm run lint:biome && npm run lint:eslint",
      "lint:biome": "biome check src",
      "lint:eslint": "eslint .",
      "lint:fix": "npm run lint:biome:fix && npm run lint:eslint:fix",
      "lint:biome:fix": "biome check --fix --unsafe src",
      "lint:eslint:fix": "eslint . --fix",
      "format": "biome format .",
      "format:fix": "biome format . --write",
      "type-check": "tsc --noEmit",
      "validate": "npm run lint && npm run type-check",
      "clean": "rm -rf .next out node_modules/.cache",
      "ci": "npm run validate && npm run build",
      "precommit": "npm run lint:fix && npm run format:fix"
   },
   "dependencies": {
      "@ducanh2912/next-pwa": "^10.2.9",
      "@mapbox/mapbox-gl-geocoder": "^5.1.2",
      "@supabase/supabase-js": "^2.103.1",
      "@tanstack/react-query": "^5.99.0",
      "fp-ts": "^2.16.11",
      "framer-motion": "^12.38.0",
      "idb": "^8.0.3",
      "lucide-react": "^1.8.0",
      "mapbox-gl": "^3.21.0",
      "motion": "^12.38.0",
      "next": "^16.2.3",
      "ogl": "^1.0.11",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "react-icons": "^5.6.0",
      "react-modal-sheet": "^5.6.0",
      "recordrtc": "^5.6.2",
      "uuid": "^13.0.0",
      "wavesurfer.js": "^7.12.6",
      "zod": "^4.3.6",
      "zustand": "^5.0.12"
   },
   "devDependencies": {
      "@biomejs/biome": "2.3.8",
      "@eslint/js": "^9.39.4",
      "@tailwindcss/postcss": "^4.2.2",
      "@types/mapbox__mapbox-gl-geocoder": "^5.1.1",
      "@types/mapbox-gl": "^3.5.0",
      "@types/node": "^24.12.2",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/uuid": "^11.0.0",
      "eslint": "^9.39.2",
      "eslint-plugin-react-you-might-not-need-an-effect": "^0.9.3",
      "globals": "^17.5.0",
      "tailwindcss": "^4.2.2",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.58.2"
   }
}
