{
   "name": "@sonory/web",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "next dev --turbopack --port 3000",
      "build": "next build",
      "start": "next start",
      "lint": "npm run lint:biome && npm run lint:eslint",
      "lint:biome": "biome check src",
      "lint:eslint": "eslint .",
      "lint:fix": "npm run lint:biome:fix && npm run lint:eslint:fix",
      "lint:biome:fix": "biome check --fix --unsafe src",
      "lint:eslint:fix": "eslint . --fix",
      "format": "biome format .",
      "format:fix": "biome format . --write",
      "type-check": "tsc --noEmit",
      "validate": "npm run lint && npm run type-check && npm run test",
      "clean": "rm -rf .next out node_modules/.cache",
      "ci": "npm run validate && npm run build",
      "test": "vitest run",
      "test:watch": "vitest --watch",
      "precommit": "npm run lint:fix && npm run format:fix"
   },
   "dependencies": {
      "@sonory/shared-types": "*",
      "@ducanh2912/next-pwa": "^10.2.9",
      "@mapbox/mapbox-gl-geocoder": "^5.1.2",
      "@supabase/supabase-js": "^2.107.0",
      "@tanstack/react-query": "^5.101.0",
      "framer-motion": "^12.40.0",
      "idb": "^8.0.3",
      "lucide-react": "^1.17.0",
      "mapbox-gl": "^3.24.0",
      "motion": "^12.40.0",
      "next": "^16.2.7",
      "ogl": "^1.0.11",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "react-icons": "^5.6.0",
      "react-modal-sheet": "^5.6.0",
      "recordrtc": "^5.6.2",
      "uuid": "^13.0.2",
      "wavesurfer.js": "^7.12.7",
      "zod": "^4.4.3",
      "zustand": "^5.0.14"
   },
   "devDependencies": {
      "@biomejs/biome": "2.3.8",
      "@eslint/js": "^9.39.4",
      "@tailwindcss/postcss": "^4.3.0",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.2",
      "@types/mapbox__mapbox-gl-geocoder": "^5.1.1",
      "@types/mapbox-gl": "^3.5.0",
      "@types/node": "^24.13.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@types/uuid": "^11.0.0",
      "eslint": "^9.39.2",
      "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.0",
      "globals": "^17.6.0",
      "jsdom": "^28.1.0",
      "tailwindcss": "^4.3.0",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.60.1",
      "vitest": "^4.1.8"
   }
}
