# Sonory Web - アプリケーション固有の .gitignore
# 共通設定はルートレベルの .gitignore で管理

# Next.js固有
next-env.d.ts

# プロジェクト固有の一時ファイル
/public/temp/
/public/cache/
/public/generated/

# Testing frameworks
# Storybook
storybook-static/

# Cypress
cypress/videos/
cypress/screenshots/

# Playwright
test-results/
playwright-report/
playwright/.cache/ 