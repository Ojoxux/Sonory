# Web (Next.js) 用の環境変数
#
# このファイルを apps/web/.env.local としてコピーして値を入れること。
#
# next dev は cd apps/web した状態で実行されるため、Next.js は
# このディレクトリ配下の .env* しか読まない。monorepo ルートの .env は
# docker compose 用であり、ここには届かない。
#
# NEXT_PUBLIC_* はビルド時にクライアントバンドルへインライン展開される。
# デプロイ時は next build を実行する環境（CI など）にも同じ値が必要。

# Supabase（匿名サインインと Realtime 購読に使用）
# anon キーは公開前提の値。service_role キーは絶対にここへ置かないこと。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-key

# Mapbox GL JS v3 のアクセストークン
NEXT_PUBLIC_MAPBOX_TOKEN=pk.example.mapbox-token-goes-here

# API とサイトの URL
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PWA のアプリ名（マニフェストとメタデータに使用）
NEXT_PUBLIC_APP_NAME=Sonory
