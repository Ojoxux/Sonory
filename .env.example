# 環境変数設定用テンプレートファイル
# このファイルを.envとしてコピーし、実際の値を設定してください
# 注意: このファイルは絶対にGitにコミットしないでください
#
# ⚠️ このファイルは docker compose 用です。
#
# Next.js は cd apps/web した状態で起動するため、ここの NEXT_PUBLIC_* は
# ブラウザに届きません。Web 用の変数は apps/web/.env.example を
# apps/web/.env.local にコピーして設定してください。
# API (wrangler) 用は apps/api/.dev.vars.example を apps/api/.dev.vars へ。

# Supabase設定（サーバー側 / API用）
# SERVICE_KEY は RLS をバイパスする。絶対にクライアントへ渡さないこと。
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-key

# CORS設定
CORS_ORIGIN=http://localhost:3000

# Python Audio Analyzer設定
PYTHON_AUDIO_ANALYZER_URL=http://audio-analyzer:8000
PYTHON_AUDIO_ANALYZER_TIMEOUT=120000

# Redis設定（必要に応じて）
REDIS_URL=redis://redis:6379

# 環境設定
ENVIRONMENT=development
LOG_LEVEL=debug