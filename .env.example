# 環境変数設定用テンプレートファイル
# このファイルを.envとしてコピーし、実際の値を設定してください
# 注意: このファイルは絶対にGitにコミットしないでください

# Mapbox設定
# Mapbox GL JS V3用のアクセストークン
NEXT_PUBLIC_MAPBOX_TOKEN=pk.example.mapbox-token-goes-here

# Web公開URL（OpenNext + Cloudflare Workers）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787

# Supabase設定（サーバー側 / API用）
# SERVICE_KEY は RLS をバイパスする。絶対にクライアントへ渡さないこと。
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-key

# Supabase設定（ブラウザ側 / Web用）
# 匿名サインイン (Auth) と Realtime の購読に使う。anon キーは公開前提の値。
#
# 注意: NEXT_PUBLIC_* は Next.js のビルド時にクライアントバンドルへ
# インライン展開される。したがって `next build` を実行する環境に
# この2つが存在していないと、ブラウザ側では undefined になる。
# wrangler.toml の [vars] に書くだけでは不十分。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-key

# CORS設定
CORS_ORIGIN=http://localhost:3000

# Python Audio Analyzer設定
PYTHON_AUDIO_ANALYZER_URL=http://audio-analyzer:8000
PYTHON_AUDIO_ANALYZER_TIMEOUT=120000

# Redis設定（必要に応じて）
REDIS_URL=redis://redis:6379

# 環境設定
ENVIRONMENT=development
LOG_LEVEL=debug

# PWA設定
# アプリケーション名（マニフェストとメタデータに使用）
NEXT_PUBLIC_APP_NAME=Sonory