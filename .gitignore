# Sonory Monorepo - Root .gitignore
# モノレポ全体に共通するファイルのみを管理
# アプリケーション固有のファイルは各アプリケーションの.gitignoreで管理

# Dependencies (ワークスペース全体)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment files (ルートレベル)
.env
.env.local
.env.development
.env.production
.env.test

# Turborepo
.turbo

# Next.js build files (ルートレベルに出力される場合)
.next/

# Shared packages build outputs
packages/*/dist/
packages/*/build/
packages/*/*.tsbuildinfo

# OS generated files
.DS_Store
Thumbs.db
*~

# IDE settings (個人設定のみ除外、プロジェクト設定は共有)
.vscode/settings-personal.json
.idea/
*.swp
*.swo

# Logs (プロジェクト全体)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Temporary files
*.tmp
*.temp

# Deployment (プロジェクト全体)
.vercel

# Security
*.pem

# Testing (プロジェクト全体)
coverage/

# Other
*.tsbuildinfo